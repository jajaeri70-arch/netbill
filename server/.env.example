PORT=3020
NODE_ENV=development

# Database (Laragon default: root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=netbill

# Keamanan
JWT_SECRET=netbill-jwt-super-secret-change-in-production
JWT_EXPIRES=12h
APP_KEY=NetBillStaticKey_ChangeInProduction32

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Google Maps Platform. Aktifkan Places API (New), batasi key ke IP server.
# Key hanya dipakai backend untuk nama/alamat tempat di dekat titik peta.
GOOGLE_MAPS_API_KEY=

# MiberConnect WhatsApp. Jangan masukkan nilai ini ke frontend atau Git.
MIBER_BASE_URL=https://meta.miber.id/api/v1/external
MIBER_API_KEY=wag_xxx
MIBER_WHATSAPP_ACCOUNT_ID=
MIBER_LANGUAGE_CODE=id
# Nama template Meta approved. Kosong = event Miber tidak dikirim.
MIBER_TEMPLATE_INVOICE=
MIBER_TEMPLATE_H7=
MIBER_TEMPLATE_H3=
MIBER_TEMPLATE_H1=
MIBER_TEMPLATE_DUE=
MIBER_TEMPLATE_OVERDUE=
MIBER_TEMPLATE_PAID=
# JSON components sesuai detail template Miber, contoh template tanpa variabel: []
MIBER_TEMPLATE_INVOICE_COMPONENTS=[]
MIBER_TEMPLATE_H7_COMPONENTS=[]
MIBER_TEMPLATE_H3_COMPONENTS=[]
MIBER_TEMPLATE_H1_COMPONENTS=[]
MIBER_TEMPLATE_DUE_COMPONENTS=[]
MIBER_TEMPLATE_OVERDUE_COMPONENTS=[]
MIBER_TEMPLATE_PAID_COMPONENTS=[]
